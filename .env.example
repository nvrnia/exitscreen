# Copy this file to .env and fill in the blanks.
# .env is gitignored - it never gets committed.
#
# From developer.ticktick.com/manage:
TICKTICK_CLIENT_ID=
TICKTICK_CLIENT_SECRET=
TICKTICK_REDIRECT_URI=http://127.0.0.1:8080

# Filled in automatically by tools/ticktick_auth.py once you authorise.
# Leave blank to start.
TICKTICK_ACCESS_TOKEN=
TICKTICK_PROJECT_ID=
